{
  "manifest_version": 3,
  "name": "쇼핑리뷰분석",
  "version": "0.1.0",
  "description": "쿠팡·네이버 상품 리뷰를 AI로 분석해 감성 비율, 인사이트, 키워드 마인드맵을 보여주는 무료 확장 프로그램",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "쇼핑리뷰분석"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "downloads"],
  "host_permissions": [
    "https://www.coupang.com/*",
    "https://m.coupang.com/*",
    "https://smartstore.naver.com/*",
    "https://m.smartstore.naver.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.coupang.com/*", "https://m.coupang.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/coupang.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://smartstore.naver.com/*", "https://m.smartstore.naver.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/naver.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
