# 카카오 디벨로퍼스 콘솔(https://developers.kakao.com)에서 앱을 등록한 뒤
# "내 애플리케이션 > 앱 키"에서 발급받는 REST API 키. .env.local에 실제 값을 넣을 것 —
# 이 파일에는 값을 채우지 않는다.
KAKAO_REST_API_KEY=

# 구글 클라우드 콘솔(https://console.cloud.google.com) > API 및 서비스 > 사용자 인증 정보에서
# 발급받는 API 키. 이 프로젝트에서 "Places API (New)"가 사용 설정되어 있어야 한다
# (레거시 Places API만 켜져 있으면 places:searchText 호출이 403으로 실패한다).
# .env.local에 실제 값을 넣을 것 — 이 파일에는 값을 채우지 않는다.
GOOGLE_PLACES_API_KEY=

# 구글 AI Studio(https://aistudio.google.com/apikey)에서 발급받는 제미나이 API 키.
# 무료 등급은 분당/일일 요청 한도가 있다 — 이 기능이 브라우저 localStorage에 분석 결과를
# 만료 없이 캐싱하는 이유 중 하나다. .env.local에 실제 값을 넣을 것 — 이 파일에는 값을
# 채우지 않는다.
GEMINI_API_KEY=

# 비밀값이 아니므로 기본값을 그대로 채워 둔다. 구글이 모델 라인업을 자주 바꾸므로, AI
# Studio에서 현재 쓸 수 있는 모델명을 확인해 다르면 .env.local에서 덮어쓸 것.
GEMINI_MODEL=gemini-3.6-flash

# Supabase 프로젝트 URL과 anon(publishable) 키. 둘 다 비밀값이 아니다 — 카카오맵 JS 키와
# 같은 성격으로, 브라우저(auth.js)에도 그대로 노출된다. 로그인(Supabase Auth)과
# place-info(위치 정보 제보) 저장에 쓴다. Supabase 대시보드 > Project Settings > API에서
# 확인할 수 있다.
SUPABASE_URL=https://srhnwzcnimadmoyfukwd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_lszrxj-ZCq3itUfcrqatrg_HPefI61I
